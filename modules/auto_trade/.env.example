# Auto Trading System - Environment Configuration
# ================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ====================
# DATABASE (DynamoDB)
# ====================
# The system relies on AWS DynamoDB for persistence.
DYNAMODB_TABLE_NAME=AutoTrade
# DYNAMODB_ENDPOINT_URL=http://localhost:8000  # Uncomment for local dev
AWS_REGION=ap-southeast-1

# ====================
# BINANCE API
# ====================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=True  # Set to False for production

# ====================
# SYSTEM SETTINGS
# ====================
DRY_RUN=True  # Set to False to enable real trading (DANGEROUS!)
XGBOOST_TRAINER_FUNCTION_NAME=xgboost-trainer

# ====================
# TELEGRAM BOT (Optional)
# ====================
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ====================
# NOTES
# ====================
# AWS Production (DynamoDB):
#   DYNAMODB_TABLE_NAME=AutoTrade
#   AWS_REGION=ap-southeast-1
#
# Local DynamoDB Testing:
#   DYNAMODB_ENDPOINT_URL=http://localhost:8000
#   DYNAMODB_TABLE_NAME=AutoTrade
#   AWS_DEFAULT_REGION=us-east-1
