# Auto Trading System - Environment Configuration
# ================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ====================
# BINANCE API
# ====================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=True  # Set to False for production

# ====================
# SYSTEM SETTINGS
# ====================
DRY_RUN=True  # Set to False to enable real trading (DANGEROUS!)

# ====================
# TELEGRAM BOT (Optional)
# ====================
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ====================
# NOTES
# ====================
# 1. Get Binance API key from: https://www.binance.com/en/my/settings/api-management
# 2. For testnet, use: https://testnet.binancefuture.com
# 3. Create Telegram bot via @BotFather to get token
# 4. Get your chat ID by messaging @userinfobot
