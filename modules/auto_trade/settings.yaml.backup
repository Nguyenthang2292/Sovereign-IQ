risk:
  limits_enabled: false
  max_position_size: 100.0
  max_open_positions: 1
  max_daily_loss: 100.0
  default_leverage: 5x
filters:
  timeframe: 15m
  min_signal_score: 0.7
  enable_xgboost: true
  atc_threshold: 0.19999999999999996
  symbol_whitelist: 'BTC/USDT

    ETH/USDT

    SOL/USDT

    '
  min_volume: 50.0
  whitelist_symbols: []
api:
  exchange: Binance
  mode: PRODUCTION
  api_key: ''
  api_secret: ''
tp_sl:
  default_tp: 2.5
  default_sl: 80.0
  trailing_stop: false
  trailing_step_pct: 2.0
  trailing_limit_steps: false
  trailing_max_steps: 5
  mode: ROI
  negative_be_enabled: true
  negative_be_threshold_pct: 10.0
auto_close:
  enabled: true
  max_duration_enabled: true
  max_duration_hours: 4.0
  daily_close_enabled: false
  daily_close_time: '22:00'
  daily_close_days: '1234567'
  grace_period_minutes: 5
  tp_offset_pct: 0.05
scanner:
  scan_interval: 5
  timeframe: 15m
  atc_backend: serverless
  xgboost_backend: serverless
  sampling_strategy: stratified
  sample_percentage: 30
  auto_start: false
  min_signal_score: 0.19
  min_volume: 5.0
  enable_xgboost: false
  atc_threshold: 0.21
  enable_gann_square: true
  gann_timeframe: 30m
  gann_candle_limit: 200
  gann_lookback: 5
  enable_order_book: false
  ob_depth: 20
  ob_imbalance_threshold: 0.2
order_book_imbalance:
  enabled: false
  threshold: 0.2
  retry_wait_seconds: 30
  max_retries: 2
  delta_window_minutes: 5
ui:
  theme: dark
  font_size: 12
  window_size:
    width: 1200
    height: 800
  last_active_tab: Dashboard
  column_visibility: {}
  widget_order: {}
recovery:
  initial_loss: 0.0
  target_profit_per_trade: 8.0
  max_recovery_trades: 13
  margin_scaling_mode: adaptive
  leverage_scaling_mode: adaptive
  min_leverage: 5
  max_leverage: 15
  enable_streak_bonus: true
  enabled: true
trading:
  default_position_size: 100.0
  default_leverage: 2
