risk:
  limits_enabled: false
  max_position_size: 100.0
  max_open_positions: 1
  max_daily_loss: 100.0
  default_leverage: 5x
filters:
  min_signal_score: 0.19999999999999996
  enable_xgboost: true
  atc_threshold: 0.19999999999999996
  symbol_whitelist: 'BTC/USDT

    ETH/USDT

    SOL/USDT

    '
  min_volume: 10.0
  timeframe: 15m
api:
  exchange: Binance
  mode: PRODUCTION
  api_key: ''
  api_secret: ''
tp_sl:
  default_tp: 2.0
  default_sl: 30.0
  trailing_stop: false
  trailing_step_pct: 2.0
  trailing_limit_steps: false
  trailing_max_steps: 5
  mode: ROI
  negative_be_enabled: true
  negative_be_threshold_pct: 10.0
scanner:
  scan_interval: 5
  timeframe: 15m
  atc_backend: serverless
  xgboost_backend: serverless
  symbol_list: Top 20
  auto_start: true
  retrain_xgboost: false
  running: false
  sampling_strategy: stratified
  sample_percentage: 50
ui:
  theme: dark
  font_size: 12
  window_size:
    width: 1200
    height: 800
  last_active_tab: Dashboard
  column_visibility: {}
  widget_order: {}
recovery:
  initial_loss: 0.0
  target_profit_per_trade: 8.0
  max_recovery_trades: 13
  margin_scaling_mode: adaptive
  leverage_scaling_mode: adaptive
  min_leverage: 5
  max_leverage: 15
  enable_streak_bonus: true
  enabled: true
trading:
  default_position_size: 100.0
  default_leverage: 2
