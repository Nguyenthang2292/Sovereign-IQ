# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy file này thành .env và điền credentials thực của bạn
# File .env được gitignore – KHÔNG COMMIT credentials lên git!
#
#   cp .env.example .env
#
# =============================================================================


# -----------------------------------------------------------------------------
# AWS CREDENTIALS
# -----------------------------------------------------------------------------
# Lấy từ: AWS Console → IAM → Users → <user> → Security credentials
# Hoặc dùng AWS CLI: aws configure
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE

# AWS Region mặc định (dự án dùng ap-southeast-1 = Singapore)
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1

# (Tuỳ chọn) AWS Profile nếu dùng nhiều tài khoản AWS
# AWS_PROFILE=default


# -----------------------------------------------------------------------------
# DYNAMODB CONFIGURATION
# -----------------------------------------------------------------------------

# Tên bảng DynamoDB chính
DYNAMODB_TABLE_NAME=AutoTrade

# (Tuỳ chọn) Endpoint cục bộ cho development với DynamoDB Local
# Bỏ comment dòng dưới khi chạy DynamoDB Local (docker):
# DYNAMODB_ENDPOINT_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# AWS S3 (cho XGBoost model storage – xgboost_LTS_serverless)
# -----------------------------------------------------------------------------

S3_BUCKET_NAME=xgboost-models-store

# Prefix trong bucket (thư mục)
S3_MODEL_PREFIX=models/xgboost_LTS/

# Biến dùng bởi deploy_lambda.py (phải khớp với S3_BUCKET_NAME)
MODEL_BUCKET=xgboost-models-store


# -----------------------------------------------------------------------------
# AWS LAMBDA (cho XGBoost Serverless Filter)
# -----------------------------------------------------------------------------

# Tên Lambda function cho XGBoost inference
# LAMBDA_FUNCTION_NAME=xgboost-lts-inference

# ARN của Lambda function (thay thế cho tên nếu cross-account)
# LAMBDA_FUNCTION_ARN=arn:aws:lambda:ap-southeast-1:123456789012:function:xgboost-lts-inference


# -----------------------------------------------------------------------------
# BINANCE API
# -----------------------------------------------------------------------------

# Binance Futures API (Testnet hoặc Live)
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_KEY_HERE

# Chế độ: testnet | live
BINANCE_ENV=testnet

# Binance Testnet endpoints (tự động dùng khi BINANCE_ENV=testnet)
# BINANCE_TESTNET_BASE_URL=https://testnet.binancefuture.com
# BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com


# -----------------------------------------------------------------------------
# TRADING CONFIGURATION
# -----------------------------------------------------------------------------

# Chế độ khô (không đặt lệnh thật): True | False
DRY_RUN=True

# Mức log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
